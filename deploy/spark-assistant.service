[Unit]
Description=Telegram personal assistant
After=network-online.target sparkmodel.service
Wants=network-online.target sparkmodel.service

[Service]
User=giospark1
WorkingDirectory=/home/giospark1/telegramManager
EnvironmentFile=/home/giospark1/telegramManager/.env
ExecStart=/home/giospark1/telegramManager/.venv/bin/python3 -m bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
