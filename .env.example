TELEGRAM_BOT_TOKEN=  # bot token from @BotFather
TELEGRAM_USER_ID=  # your numeric Telegram user id (only this user is allowed)
OPENAI_BASE_URL=  # base URL of the OpenAI-compatible chat endpoint
OPENAI_API_KEY=  # API key for the chat endpoint (use "unused" for local vLLM)
CHAT_MODEL=  # chat model name to request
CHAT_ENABLE_THINKING=false  # Qwen-style backends only; leave false for fast tool calls
FALLBACK_BASE_URL=  # base URL of the fallback chat endpoint used when the primary is unreachable (optional)
FALLBACK_API_KEY=  # API key for the fallback endpoint
FALLBACK_MODEL=  # chat model name to request from the fallback endpoint
VISION_BASE_URL=  # base URL of the OpenAI-compatible vision endpoint (optional)
VISION_MODEL=  # vision model name to request (optional)
FALLBACK_VISION_MODEL=  # optional; a vision-capable Fireworks model for photo checks/OCR when the Spark is down
GOOGLE_MAPS_API_KEY=  # Google Maps API key (optional)
KNOWLEDGE_DIR=  # directory holding the knowledge base markdown files
KNOWLEDGE_REMOTES=  # comma-separated git URLs to push the knowledge repo to after every change (backups); bare repos on machines you control (Spark, Mac) — do not use GitHub for personal data
DATA_DIR=  # directory for persistent runtime data
WHISPER_MODEL=  # faster-whisper model size for voice input (default small; use base on a small CPU)
KOKORO_MODEL_DIR=  # directory containing kokoro-v1.0.onnx and voices-v1.0.bin for voice replies (default ./models)
