TELEGRAM_BOT_TOKEN=  # bot token from @BotFather
TELEGRAM_USER_ID=  # your numeric Telegram user id (only this user is allowed)
OPENAI_BASE_URL=  # base URL of the OpenAI-compatible chat endpoint
OPENAI_API_KEY=  # API key for the chat endpoint (use "unused" for local vLLM)
CHAT_MODEL=  # chat model name to request
VISION_BASE_URL=  # base URL of the OpenAI-compatible vision endpoint (optional)
VISION_MODEL=  # vision model name to request (optional)
GOOGLE_MAPS_API_KEY=  # Google Maps API key (optional)
KNOWLEDGE_DIR=  # directory holding the knowledge base markdown files
DATA_DIR=  # directory for persistent runtime data
