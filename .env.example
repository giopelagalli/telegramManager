# ── Required ───────────────────────────────────────────────────────────
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# @userinfobot
TELEGRAM_USER_ID=
# app.fireworks.ai → Account → API Keys
FIREWORKS_API_KEY=

# ── Spark (leave blank until it is reachable; then Fireworks becomes the fallback)
# e.g. http://<spark-tailscale-name>:8888/v1
SPARK_URL=

# ── Optional ───────────────────────────────────────────────────────────
# web search for questions that need outside info (api.search.brave.com, Free plan)
BRAVE_API_KEY=
# live traffic for leave-by times
GOOGLE_MAPS_API_KEY=
# comma-separated bare-repo URLs on machines you control (Spark, Mac); never GitHub
KNOWLEDGE_REMOTES=

# ── Advanced overrides (normally leave alone; anything set here wins over the derived value)
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash   # used for chat/fallback, vision, /hard
# FIREWORKS_STT_MODEL=whisper-v3
# EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5   # embeddings for recall; check the id on app.fireworks.ai/models     # voice notes; check the id on app.fireworks.ai/models if voice fails
# SPARK_MODEL=qwen3.8-flash-next
# OPENAI_BASE_URL= / OPENAI_API_KEY= / CHAT_MODEL= / CHAT_ENABLE_THINKING=   # primary chat endpoint
# CHAT_EXTRA_BODY=   # JSON merged into every primary request, e.g. DeepSeek's thinking-off parameter from its Fireworks page
# VISION_BASE_URL= / VISION_MODEL=                                          # photo checks and OCR
# FALLBACK_BASE_URL= / FALLBACK_API_KEY= / FALLBACK_MODEL= / FALLBACK_EXTRA_BODY=
# FALLBACK_VISION_MODEL= / FALLBACK_VISION_EXTRA_BODY=
# HARD_MODEL= / HARD_EXTRA_BODY=      # /hard; EXTRA_BODY is JSON merged into every request (thinking params)
# STT_PROVIDER=local|api / STT_BASE_URL= / STT_API_KEY= / STT_MODEL= / WHISPER_MODEL=small
# KNOWLEDGE_DIR= / DATA_DIR= / KOKORO_MODEL_DIR=   # default: knowledge/, data/, models/ inside the repo
